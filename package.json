{
  "name": "cloud-engineering-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:labs && vite --host 127.0.0.1",
    "build": "npm run prepare:labs && tsc --noEmit && vite build",
