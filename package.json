    "prepare:labs": "node scripts/package-labs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
